# Create a Supabase project, then copy these into .env.local
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute URL of this app, used for magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# All event times are stored as absolute instants and shown in this zone.
# Set this to where the club actually plays — leaving the default puts games
# 11 hours off for an Asian club.
NEXT_PUBLIC_CLUB_TIMEZONE=Asia/Jakarta
